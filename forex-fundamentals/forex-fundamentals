    def get_current_session(self, current_time: datetime) -> MarketSession:
        """Determine current market session."""
        est_time = self.convert_to_est(current_time)
        
        hour = est_time.hour
        
        if 5 <= hour < 14:
            return MarketSession.SYDNEY
        elif 19 <= hour < 24 or 0 <= hour < 4:
            return MarketSession.TOKYO
        elif 3 <= hour < 12:
            return MarketSession.LONDON
        elif 8 <= hour < 17:
            return MarketSession.NEW_YORK
        else:
            return MarketSession.TOKYO  # Default to Tokyo during Asian session
    
    def convert_to_est(self, dt: datetime) -> datetime:
        """Convert UTC datetime to EST timezone."""
        # For demo purposes, assume UTC is same as EST (simplified)
        return dt
    
    def is_market_open(self, current_time: datetime) -> bool:
        """Check if Forex market is currently open."""
        est_time = self.convert_to_est(current_time)
        day = est_time.weekday()
        hour = est_time.hour
        
        # Market is open Sunday 5pm EST to Friday 4pm EST
        if day == 6 and 17 <= hour < 24:  # Sunday evening
            return True
        elif day < 5:  # Monday-Thursday
            return True
        elif day == 4 and hour < 16:  # Friday before 4pm
            return True
        
        return False
    
