def main():
    """Main CLI handler."""
    parser = argparse.ArgumentParser(description="Forex Fundamental Analysis CLI Tool")
    subparsers = parser.add_subparsers(dest='command', help='Available commands')
    
    # Market overview
    overview_parser = subparsers.add_parser('market-overview', help='Get comprehensive market overview')
    
    # Calendar
    calendar_parser = subparsers.add_parser('calendar', help='Economic calendar')
    calendar_parser.add_argument('period', choices=['today', 'week', 'month'], default='today', nargs='?', help='Calendar period')
    calendar_parser.add_argument('--country', help='Filter by country')
    calendar_parser.add_argument('--indicator', help='Filter by indicator')
    calendar_parser.add_argument('--high-impact', action='store_true', help='Show high-impact events only')
    
    # Outlook
    outlook_parser = subparsers.add_parser('outlook', help='Currency fundamental outlook')
    outlook_parser.add_argument('currency', help='Currency code (e.g., USD, EUR, GBP)')
    
    # Correlation
    correlate_parser = subparsers.add_parser('correlate', help='Analyze indicator correlation')
    correlate_parser.add_argument('indicator1', help='First indicator')
    correlate_parser.add_argument('indicator2', help='Second indicator')
    correlate_parser.add_argument('--period', default='6mo', help='Analysis period')
    
    # Sentiment
    sentiment_parser = subparsers.add_parser('sentiment', help='Market sentiment analysis')
    
    # Signals
    signals_parser = subparsers.add_parser('signals', help='Generate trading signals')
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return
    
    skill = ForexFundamentalsSkill()
    
    if args.command == 'market-overview':
        skill.market_overview()
    elif args.command == 'calendar':
        skill.calendar(args.period, args.country, args.indicator, args.high_impact)
    elif args.command == 'outlook':
        skill.outlook(args.currency.upper())
    elif args.command == 'correlate':
        skill.correlate(args.indicator1.upper(), args.indicator2.upper(), args.period)
    elif args.command == 'sentiment':
        skill.sentiment()
    elif args.command == 'signals':
        skill.signals()

if __name__ == "__main__":
    main()