    def init_database(self):
        """Initialize SQLite database for storing economic data and signals."""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        # Economic events table
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS economic_events (
                id TEXT PRIMARY KEY,
                country TEXT,
                currency TEXT,
                indicator TEXT,
                name TEXT,
                time TEXT,
                impact TEXT,
                previous TEXT,
                forecast TEXT,
                actual TEXT,
                deviation TEXT,
                market_response TEXT,
                created_at TEXT
            )
        ''')
        
        # Currency fundamentals table
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS currency_fundamentals (
                currency TEXT PRIMARY KEY,
                outlook TEXT,
                strength TEXT,
                central_bank_focus TEXT,
                policy_direction TEXT,
                key_factors TEXT,
                risk_factors TEXT,
                last_updated TEXT
            )
        ''')
        
        # Trading signals table
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS trading_signals (
                signal_id TEXT PRIMARY KEY,
                currency_pair TEXT,
                direction TEXT,
                confidence TEXT,
                reason TEXT,
                entry_price REAL,
                stop_loss REAL,
                take_profit REAL,
                risk_reward_ratio TEXT,
                timeframe TEXT,
                fundamental_basis TEXT,
                timestamp TEXT,
                created_at TEXT
            )
        ''')
        
        conn.commit()
        conn.close()
    
