    def get_currency_fundamentals(self, currency: str) -> Optional[CurrencyFundamentals]:
        """Get currency fundamentals from database."""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute("SELECT * FROM currency_fundamentals WHERE currency = ?", (currency,))
        row = cursor.fetchone()
        
        conn.close()
        
        if row:
            return CurrencyFundamentals(
                currency=row[0],
                outlook=CurrencyOutlook(row[1]),
                strength=row[2],
                central_bank_focus=json.loads(row[3]) if row[3] else [],
