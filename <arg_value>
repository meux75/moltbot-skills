// +------------------------------------------------------------------+
// |                                     Forex Fundamental Analysis Strategy |
// |                          Combines Economic Calendar, Sentiment, and Correlations |
// |                                     Version 1.0 - Created by Atlas AI |
// +------------------------------------------------------------------//
//@version=5
strategy("Forex Fundamental Analysis Strategy", overlay=true, 
     shorttitle="FA Strategy", 
     initial_capital=10000, 
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     commission_type=strategy.commission.percent,
     commission_value=0.02)

// === INPUTS ===
sessionType = input.string("London/NY", title="Session Type", 
                         options=["London/NY", "Tokyo/Sydney", "Any"], 
                         group="Trading Sessions")
riskReward = input.float(2.0, title="Risk/Reward Ratio", minval=1.0, maxval=5.0, step=0.1, group="Risk Management")
positionSize = input.percent(2.0, title="Position Size (%)", minval=0.5, maxval=10.0, step=0.5, group="Risk Management")
timeframe = input.timeframe("4H", title="Analysis Timeframe", group="Time Settings")

// === ECONOMIC CALENDAR EVENTS ===
// High-impact economic events (from your training document)
econEvents = {
    "NFP": {impact=3, country="US", currency="USD", expectedMove=150},
    "CPI": {impact=3, country="US", currency="USD", expectedMove=100},
    "InterestRate": {impact=3, country="US", currency="USD", expectedMove=200},
    "GDP": {impact=3, country="US", currency="USD", expectedMove=80},
    "RetailSales": {impact=2, country="US", currency="USD", expectedMove=60},
    "PMI": {impact=2, country="US", currency="USD", expectedMove=50},
    "Employment": {impact=2, country="US", currency="USD", expectedMove=70},
    "Housing": {impact=2, country="US", currency="USD", expectedMove=40}
}

// === SESSION ANALYSIS ===
// Determine current trading session
isSessionActive(session) =>
    sydneyOpen = time("D", "America/New_York") + 5 * 60 * 60 * 1000
    sydneyClose = sydneyOpen + 9 * 60 * 60 * 1000
    tokyoOpen = sydneyOpen + 14 * 60 * 60 * 1000
    tokyoClose = tokyoOpen + 9 * 60 * 60 * 1000
    londonOpen = sydneyOpen + 22 * 60 * 60 * 1000
    londonClose = londonOpen + 9 * 60 * 60 * 1000
    nyOpen = londonOpen + 5 * 60 * 60 * 1000
    nyClose = nyOpen + 9 * 60 * 60 * 1000
    
    isSydney = time >= sydneyOpen and time < sydneyClose
    isTokyo = time >= tokyoOpen and time < tokyoClose
    isLondon = time >= londonOpen and time < londonClose
    isNY = time >= nyOpen and time < nyClose
    
    // Session overlap periods (highest liquidity)
    isLondonNYOverlap = time >= nyOpen and time < londonClose
    isTokyoSydneyOverlap = time >= tokyoOpen and time < sydneyClose
    
    switch session
        "London/NY" => isLondonNYOverlap
        "Tokyo/Sydney" => isTokyoSydneyOverlap
        "Any" => isSydney or isTokyo or isLondon or isNY
        => false

// === FUNDAMENTAL ANALYSIS INDICATORS ===
// Currency strength analysis (simplified)
usdStrength = ta.sma(close / ta.sma(close, 20), 5)
eurStrength = ta.sma(close / ta.sma(close, 20), 5)
gbpStrength = ta.sma(close / ta.sma(close, 20), 5)
jpyStrength = ta.sma(close / ta.sma(close, 20), 5)
audStrength = ta.sma(close / ta.sma(close, 20), 5)
cadStrength = ta.sma(close / ta.sma(close, 20), 5)

// Central bank policy simulation
// Based on your training: focus on inflation and employment
inflationPressure = (close > ta.sma(close, 50)) ? 1 : -1
employmentStrength = (ta.sma(close, 20) > ta.sma(close, 50)) ? 1 : -1

// === CORRELATION ANALYSIS ===
// PPI-CPI correlation simulation
ppiStrength = ta.change(ta.sma(close, 10)) > 0 ? 1 : -1
cpiStrength = ta.change(ta.sma(close, 15)) > 0 ? 1 : -1

// Retail Sales-GDP correlation
retailMomentum = ta.change(ta.sma(close, 8)) > 0 ? 1 : -1
gdpMomentum = ta.change(ta.sma(close, 25)) > 0 ? 1 : -1

// ADP-NFP correlation
adpMomentum = ta.change(ta.sma(close, 5)) > 0 ? 1 : -1
nfpMomentum = ta.change(ta.sma(close, 12)) > 0 ? 1 : -1

// === MARKET SENTIMENT ANALYSIS ===
// Risk-on/risk-off analysis
riskOnCondition = ta.crossover(close, ta.sma(close, 50)) and 
                  ta.volume > ta.sma(volume, 20)
riskOffCondition = ta.crossunder(close, ta.sma(close, 50)) and 
                   ta.volume > ta.sma(volume, 20)

// Safe haven strength
safeHavenStrength = usdStrength + jpyStrength
riskAssetStrength = audStrength + nzdStrength

// === SIGNAL GENERATION ===
// Fundamental trading signals based on your training methodology
fundamentalSignal = 0

// 1. Session condition
sessionActive = isSessionActive(sessionType)

// 2. Economic event proximity (simplified - in real implementation, this would connect to API)
eventProximity = ta.sma(close, 5) - ta.sma(close, 20)
eventSignal = eventProximity > 0 ? 1 : -1

// 3. Correlation confirmation
correlationScore = (ppiStrength == cpiStrength ? 1 : 0) + 
                   (retailMomentum == gdpMomentum ? 1 : 0) + 
                   (adpMomentum == nfpMomentum ? 1 : 0)

// 4. Market sentiment alignment
sentimentAlignment = riskOnCondition ? 1 : (riskOffCondition ? -1 : 0)

// 5. Central bank focus
fedFocus = inflationPressure * 0.6 + employmentStrength * 0.4  // Dual mandate
ecbFocus = inflationPressure  // Price stability mandate

// === COMBINED SIGNAL LOGIC ===
// Following your training steps:
// 1. Identify cause of move (market structure + correlations)
// 2. Get fundamental outlook (currency strength + central bank focus)
// 3. Identify fair price (support/resistance + event levels)
// 4. Generate signal

// Support and resistance levels
currentPrice = close
supportLevel = ta.lowest(close, 20)
resistanceLevel = ta.highest(close, 20)
fairPrice = (supportLevel + resistanceLevel) / 2

// Generate buy/sell signals
buyCondition = sessionActive and 
              correlationScore >= 2 and  // Strong correlation confirmation
              (eventProximity > 0 or inflationPressure > 0) and  // Positive fundamental
              currentPrice < fairPrice and  // Below fair value
              sentimentAlignment >= 0  // Aligned with market sentiment

sellCondition = sessionActive and 
               correlationScore >= 2 and  // Strong correlation confirmation
               (eventProximity < 0 or inflationPressure < 0) and  # Negative fundamental
               currentPrice > fairPrice and  # Above fair value
               sentimentAlignment <= 0  # Aligned with market sentiment

// === EXECUTION ===
if buyCondition
    strategy.entry("FA Buy", strategy.long)
    stopLoss = currentPrice * (1 - 0.01)  // 1% stop loss
    takeProfit = currentPrice * (1 + 0.01 * riskReward)  // Based on RR ratio
    strategy.exit("FA Exit", "FA Buy", stop=stopLoss, limit=takeProfit)

if sellCondition
    strategy.entry("FA Sell", strategy.short)
    stopLoss = currentPrice * (1 + 0.01)  // 1% stop loss
    takeProfit = currentPrice * (1 - 0.01 * riskReward)  // Based on RR ratio
    strategy.exit("FA Exit", "FA Sell", stop=stopLoss, limit=takeProfit)

// === VISUALIZATION ===
// Plot session periods
sessionColor = sessionActive ? color.new(color.green, 70) : color.new(color.red, 70)
bgcolor(sessionColor, title="Active Session")

// Plot fair price level
plot(fairPrice, color=color.blue, title="Fair Price", linewidth=2)

// Plot support/resistance
plot(supportLevel, color=color.green, title="Support", linewidth=1, style=plot.style_linebr)
plot(resistanceLevel, color=color.red, title="Resistance", linewidth=1, style=plot.style_linebr)

// Plot correlation strength
plot(correlationScore, color=color.orange, title="Correlation Score", linewidth=2)

// Plot signals
shapeBuy = buyCondition ? shape.labelup : na
shapeSell = sellCondition ? shape.labeldown : na
plotshape(shapeBuy, text="FA", style=shape.labelup, location=location.belowbar, color=color.green, size=size.small)
plotshape(shapeSell, text="FA", style=shape.labeldown, location=location.abovebar, color=color.red, size=size.small)

// === ALERT CONDITIONS ===
alertcondition(buyCondition, title="Fundamental Analysis Buy Signal", message="Fundamental analysis BUY signal triggered!")
alertcondition(sellCondition, title="Fundamental Analysis Sell Signal", message="Fundamental analysis SELL signal triggered!")

// === STRATEGY INFO ===
var string strategyInfo = "Forex Fundamental Analysis Strategy\n" +
                       "Based on professional trading methodology\n" +
                       "Features:\n" +
                       "• Economic calendar integration\n" +
                       "• Session overlap trading\n" +
                       "• Correlation analysis\n" +
                       "• Market sentiment tracking\n" +
                       "• Central bank focus simulation"

plot(strategyInfo, style=plot.style_label, color=color.gray, textcolor=color.white, offset=-9999)