        table.add_row("Revenue", format_number(info.get('totalRevenue')))
        table.add_row("Net Income", format_number(info.get('netIncomeToCommon')))
        table.add_row("Gross Margin", f"{info.get('grossMargins', 0)*100:.1f}%")
        table.add_row("Operating Margin", f"{info.get('operatingMargins', 0)*100:.1f}%")
        table.add_row("Net Margin", f"{info.get('netMargins', 0)*100:.1f}%")
        
        # Valuation
        table.add_row("P/E Ratio", str(info.get('trailingPE', 'N/A')))
        table.add_row("Forward P/E", str(info.get('forwardPE', 'N/A')))
        table.add_row("P/S Ratio", f"{info.get('priceToSalesTrailing12Months', 0):.2f}")
        table.add_row("P/B Ratio", f"{info.get('priceToBook', 0):.2f}")
        table.add_row("EV/EBITDA", f"{info.get('enterpriseToEbitda', 0):.2f}")
        
        # Financial Health
        table.add_row("Debt/Equity", f"{info.get('debtToEquity', 0):.2f}")
        table.add_row("Current Ratio", f"{info.get('currentRatio', 0):.2f}")
        table.add_row("Quick Ratio", f"{info.get('quickRatio', 0):.2f}")
        table.add_row("ROE", f"{info.get('returnOnEquity', 0)*100:.1f}%")
        table.add_row("ROA", f"{info.get('returnOnAssets', 0)*100:.1f}%")
        
