console = Console()

def format_currency(value):
    """Format currency values."""
    if value is None or value == 0:
        return "N/A"
    return f"${value:,.2f}"

def format_percentage(value):
    """Format percentage values."""
    if value is None:
        return "N/A"
    return f"{value:+.2f}%"

def format_number(value, precision=2):
    """Format large numbers."""
    if value is None:
        return "N/A"
    if abs(value) >= 1e9:
        return f"{value/1e9:.{precision}f}B"
    elif abs(value) >= 1e6:
        return f"{value/1e6:.{precision}f}M"
    elif abs(value) >= 1e3:
        return f"{value/1e3:.{precision}f}K"
    return f"{value:,.{precision}f}"

def get_price(symbol):
    """Get current stock price."""
    try:
        ticker = yf.Ticker(symbol)
        info = ticker.info
        
        table = Table(title=f"📈 {symbol} - Current Price")
        table.add_column("Metric", style="cyan", no_wrap=True)
        table.add_column("Value", style="green")
        
        table.add_row("Current Price", format_currency(info.get('currentPrice')))
        table.add_row("Previous Close", format_currency(info.get('previousClose')))
        table.add_row("Change", format_currency(info.get('regularMarketPrice') - info.get('previousClose', 0)))
        table.add_row("Change %", format_percentage(info.get('regularMarketPrice', 0) - info.get('previousClose', 0)) / info.get('previousClose', 1) * 100 if info.get('previousClose') else "N/A")
        table.add_row("Open", format_currency(info.get('regularMarketOpen')))
        table.add_row("Day Range", f"{format_currency(info.get('regularMarketDayLow'))} - {format_currency(info.get('regularMarketDayHigh'))}")
        table.add_row("52 Week Range", f"{format_currency(info.get('fiftyTwoWeekLow'))} - {format_currency(info.get('fiftyTwoWeekHigh'))}")
        table.add_row("Volume", format_number(info.get('regularMarketVolume')))
        table.add_row("Market Cap", format_number(info.get('marketCap')))
        table.add_row("P/E Ratio", str(info.get('trailingPE', 'N/A')))
        
        console.print(table)
    except Exception as e:
        console.print(f"[red]Error fetching data for {symbol}: {e}[/red]")

