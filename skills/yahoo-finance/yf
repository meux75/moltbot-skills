def get_dividends(symbol):
    """Get dividend information."""
    try:
        ticker = yf.Ticker(symbol)
        
        # Get dividend history
        dividends = ticker.dividends
        if dividends is not None and not dividends.empty:
            table = Table(title=f"💵 {symbol} - Dividends")
            table.add_column("Date", style="cyan")
            table.add_column("Dividend", style="green")
            
            recent_dividends = dividends.tail(5)
            for date, amount in recent_dividends.items():
                table.add_row(date.strftime('%Y-%m-%d'), format_currency(amount))
            
            console.print(table)
        
        # Get dividend info
        info = ticker.info
        if info.get('dividendYield') or info.get('dividendRate'):
            info_table = Table(title="Dividend Info")
            info_table.add_column("Metric", style="cyan")
            info_table.add_column("Value", style="green")
            info_table.add_row("Dividend Rate", format_currency(info.get('dividendRate', 0)))
            info_table.add_row("Dividend Yield", f"{info.get('dividendYield', 0)*100:.2f}%")
            console.print(info_table)
            
    except Exception as e:
        console.print(f"[red]Error fetching dividends for {symbol}: {e}[/red]")

