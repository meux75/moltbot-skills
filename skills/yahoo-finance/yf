def get_earnings(symbol):
    """Get earnings data."""
    try:
        ticker = yf.Ticker(symbol)
        info = ticker.info
        
        # Get next earnings date
        earnings_dates = ticker.get_earnings_dates(limit=4)
        if earnings_dates is not None and not earnings_dates.empty:
            next_earning = earnings_dates.iloc[0]
            table = Table(title=f"💰 {symbol} - Earnings")
            table.add_column("Metric", style="cyan", no_wrap=True)
            table.add_column("Value", style="green")
            
            table.add_row("Next Earnings Date", next_earning.get('Start Date', 'N/A'))
            table.add_row("EPS Estimate", f"{next_earning.get('EPS Estimate', 0):.2f}")
            table.add_row("Revenue Estimate", format_number(next_earning.get('Revenue Estimate', 0)))
            console.print(table)
        
        # Get earnings history
        earnings = ticker.earnings
        if earnings is not None and not earnings.empty:
            earnings_table = Table(title="Earnings History")
            earnings_table.add_column("Year", style="cyan")
            earnings_table.add_column("Revenue", style="green")
            earnings_table.add_column("EPS", style="green")
            
            for idx, row in earnings.head(5).iterrows():
                earnings_table.add_row(
                    str(idx),
                    format_number(row['Revenue']),
                    f"{row['EPS']:.2f}"
                )
            console.print(earnings_table)
            
    except Exception as e:
        console.print(f"[red]Error fetching earnings for {symbol}: {e}[/red]")

