def get_history(symbol, period):
    """Get historical price data."""
    try:
        ticker = yf.Ticker(symbol)
        hist = ticker.history(period=period)
        
        if hist is not None and not hist.empty:
            table = Table(title=f"📈 {symbol} - Historical Prices ({period})")
            table.add_column("Date", style="cyan")
            table.add_column("Open", style="green")
            table.add_column("High", style="green")
            table.add_column("Low", style="red")
            table.add_column("Close", style="green")
            table.add_column("Volume", style="yellow")
            
            # Show last 10 trading days
            recent_data = hist.tail(10)
            for date, row in recent_data.iterrows():
                table.add_row(
                    date.strftime('%Y-%m-%d'),
                    format_currency(row['Open']),
                    format_currency(row['High']),
                    format_currency(row['Low']),
                    format_currency(row['Close']),
                    format_number(row['Volume'])
                )
            
            console.print(table)
            
            # Show basic statistics
            stats_table = Table(title="Price Statistics")
            stats_table.add_column("Metric", style="cyan")
            stats_table.add_column("Value", style="green")
            
            stats_table.add_row("Current Price", format_currency(hist['Close'].iloc[-1]))
            stats_table.add_row("Period High", format_currency(hist['High'].max()))
            stats_table.add_row("Period Low", format_currency(hist['Low'].min()))
            stats_table.add_row("Period Change", format_percentage(hist['Close'].iloc[-1] - hist['Close'].iloc[0]))
            stats_table.add_row("Period Change %", format_percentage((hist['Close'].iloc[-1] - hist['Close'].iloc[0]) / hist['Close'].iloc[0] * 100))
            
            console.print(stats_table)
            
    except Exception as e:
        console.print(f"[red]Error fetching history for {symbol}: {e}[/red]")

def compare_symbols(symbols):
    """Compare multiple symbols."""
    try:
        tickers = yf.Tickers(' '.join(symbols))
        
        table = Table(title="📊 Stock Comparison")
        table.add_column("Symbol", style="cyan")
        table.add_column("Price", style="green")
        table.add_column("Change", style="green")
        table.add_column("Change %", style="green")
        table.add_column("Volume", style="yellow")
        table.add_column("Market Cap", style="green")
        table.add_column("52W High", style="green")
        table.add_column("52W Low", style="red")
        
        for symbol in symbols:
            ticker = tickers.tickers[symbol]
            info = ticker.info
            
            current_price = info.get('regularMarketPrice', 0)
            prev_close = info.get('previousClose', 0)
            change = current_price - prev_close
            change_pct = (change / prev_close * 100) if prev_close else 0
            
            table.add_row(
                symbol,
                format_currency(current_price),
                format_currency(change),
                format_percentage(change_pct),
                format_number(info.get('regularMarketVolume', 0)),
                format_number(info.get('marketCap', 0)),
                format_currency(info.get('fiftyTwoWeekHigh', 0)),
                format_currency(info.get('fiftyTwoWeekLow', 0))
            )
        
        console.print(table)
        
    except Exception as e:
        console.print(f"[red]Error comparing symbols: {e}[/red]")

def main():
    """Main CLI handler."""
    if len(sys.argv) < 2:
        console.print("[red]Usage: yf <command> [symbol] [options][/red]")
        console.print("[cyan]Available commands:[/cyan]")
        console.print("  price <symbol>      - Get current stock price")
        console.print("  quote <symbol>      - Get detailed quote")
        console.print("  fundamentals <symbol> - Get fundamental data")
        console.print("  earnings <symbol>    - Get earnings information")
        console.print("  profile <symbol>    - Get company profile")
        console.print("  dividends <symbol>  - Get dividend information")
        console.print("  ratings <symbol>    - Get analyst ratings")
        console.print("  options <symbol>    - Get options chain")
        console.print("  history <symbol> [period] - Get historical data (period: 1d,5d,1mo,3mo,6mo,1y,2y,5y,10y,ytd,max)")
        console.print("  compare <symbols>   - Compare multiple symbols (comma-separated)")
        console.print("  search <query>      - Search for stocks")
        console.print("\n[cyan]Examples:[/cyan]")
        console.print("  yf AAPL")
        console.print("  yf fundamentals NVDA")
        console.print("  yf earnings TSLA")
        console.print("  yf history GOOGL 1y")
        console.print("  yf compare AAPL,MSFT,GOOGL")
        return
    
    command = sys.argv[1].lower()
    symbol = sys.argv[2] if len(sys.argv) > 2 else None
    period = sys.argv[3] if len(sys.argv) > 3 else "1mo"
    
    if command in ['price', 'quote'] and symbol:
        get_price(symbol)
    elif command == 'fundamentals' and symbol:
        get_fundamentals(symbol)
    elif command == 'earnings' and symbol:
        get_earnings(symbol)
    elif command == 'profile' and symbol:
        get_profile(symbol)
    elif command == 'dividends' and symbol:
        get_dividends(symbol)
    elif command == 'ratings' and symbol:
        get_ratings(symbol)
    elif command == 'history' and symbol:
        get_history(symbol, period)
    elif command == 'compare' and symbol:
        compare_symbols(symbol.split(','))
    else:
        console.print(f"[red]Invalid command or missing symbol: {command} {symbol}[/red]")

if __name__ == "__main__":
    main()